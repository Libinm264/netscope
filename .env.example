# NetScope v0.7 — Environment variables
# Copy to .env and fill in the values before running docker compose up.
#
# SECURITY: Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# ClickHouse password (used by both ClickHouse and hub-api)
CLICKHOUSE_PASSWORD=change_me_strong_password

# Hub API admin key — used by agents and the dashboard to authenticate.
# Generate with: openssl rand -hex 32
API_KEY=change_me_generate_with_openssl_rand_hex_32

# ── Optional: first admin account ─────────────────────────────────────────────
# Set these to seed an initial admin user on first startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# ── Optional: AI features (Copilot + NL Flow Search) ─────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Optional: external access ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
APP_URL=http://localhost:8080
ORG_NAME=My Organisation

# ── Optional: email alerts ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Optional: port overrides ──────────────────────────────────────────────────
HUB_API_PORT=8080
HUB_WEB_PORT=3000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
