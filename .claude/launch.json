{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nexor-desktop",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 1420,
      "cwd": "desktop"
    },
    {
      "name": "nexor-hub-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "cwd": "hub/web"
    }
  ,{
      "name": "nexor-website",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-p", "4000", "."],
      "port": 4000,
      "cwd": "website"
    }
  ]
}
